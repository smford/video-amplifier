FROM alpine:3.21

# Install CA certificates and tzdata for secure upstream camera feeds and time sync
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user and application directories
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup && \
    mkdir -p /app && \
    chown -R appuser:appgroup /app

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/video-amplifier /app/video-amplifier

USER appuser
WORKDIR /app

# Expose HTTP (8080), RTSP (8554), and Metrics/Health (9090)
EXPOSE 8080 8554 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/app/video-amplifier"]
CMD ["-config", "/app/config.yaml"]
